<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado cuando el botón está presionado -->
    <item android:state_pressed="true" android:drawable="@color/color_button_pressed"/>

    <!-- Estado cuando el botón está enfocado -->
    <item android:state_focused="true" android:drawable="@color/color_button_focused"/>

    <!-- Estado por defecto -->
    <item android:drawable="@color/color_button_default"/>
</selector>


