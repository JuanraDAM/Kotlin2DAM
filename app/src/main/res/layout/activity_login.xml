<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LoginActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00D8E6"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <ImageButton
            android:id="@+id/button_menu"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/burguer_menu_ic"
            android:contentDescription="Menú"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp"
            app:tint="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PescaPro"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Logo -->
    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:src="@drawable/logo" />

    <!-- Username and Password -->
    <EditText
        android:id="@+id/usernameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="Introduce el usuario"
        android:textColorHint="@color/black"
        android:inputType="text"
        android:background="@drawable/custom_edittext_background"
        android:padding="16dp"
        android:textSize="16sp"
        android:gravity="center"
        android:alpha="0.8"
        android:scrollHorizontally="false" />


    <EditText
        android:id="@+id/passwordEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Introduce la contraseña"
        android:inputType="text"
        android:textColorHint="@color/black"
        android:background="@drawable/custom_edittext_background"
        android:padding="16dp"
        android:textSize="16sp"
        android:gravity="center"
        android:alpha="0.8"
        android:scrollHorizontally="false" />

    <!-- Register and Login Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/registerButton"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Register"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/button_background_selector"/> <!-- Aplica el selector de fondo con la forma ovalada -->




        <Button
            android:id="@+id/loginButton"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Login"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/button_background_selector" /> <!-- Aplica el selector directamente -->


    </LinearLayout>

</LinearLayout>