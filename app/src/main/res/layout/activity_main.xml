<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Pantalla de la calculadora -->
    <TextView
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#333333"
        android:gravity="end"
        android:padding="16dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/gridLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.25"/>

    <!-- GridLayout para organizar los botones -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="4dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/display"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila 1: Botones especiales -->
        <Button
            android:id="@+id/btn_ac"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:text="AC"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/boton_ac_selector"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btn_parenthesis"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:text="()"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btn_percentage"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:text="%"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btn_divide"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:text="÷"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"/>

        <!-- Fila 2: Botones de números y operaciones -->
        <Button
            android:id="@+id/btn_7"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="7"/>

        <Button
            android:id="@+id/btn_8"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="8"/>

        <Button
            android:id="@+id/btn_9"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="9"/>

        <Button
            android:id="@+id/btn_multiply"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:text="×"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"/>

        <!-- Fila 3 -->
        <Button
            android:id="@+id/btn_4"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="4"/>

        <Button
            android:id="@+id/btn_5"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="5"/>

        <Button
            android:id="@+id/btn_6"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="6"/>

        <Button
            android:id="@+id/btn_subtract"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"
            android:text="-"/>

        <!-- Fila 4 -->
        <Button
            android:id="@+id/btn_1"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="1"/>

        <Button
            android:id="@+id/btn_2"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="2"/>

        <Button
            android:id="@+id/btn_3"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="3"/>

        <Button
            android:id="@+id/btn_add"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:text="+"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"/>

        <!-- Fila 5 -->
        <Button
            android:id="@+id/btn_0"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text="0"/>

        <Button
            android:id="@+id/btn_decimal"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:background="@drawable/botones_numeros_selector"
            android:text=","/>

        <Button
            android:id="@+id/btn_delete"
            android:layout_height="1dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textColor="#C9FFFFFF"
            android:textSize="30sp"
            android:textStyle="normal"
            android:text="⌫"
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btn_equals"
            style="@style/CalculatorButton"
            android:textSize="30sp"
            android:textStyle="bold"
            android:text="="
            android:background="@drawable/botones_operaciones_selector"
            app:backgroundTint="@null"
            android:backgroundTint="#8E005494"/>
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
