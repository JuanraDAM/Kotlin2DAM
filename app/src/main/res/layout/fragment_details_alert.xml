<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título de la alerta -->
        <TextView
            android:id="@+id/txtAlertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la alerta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <!-- Fecha de la alerta -->
        <TextView
            android:id="@+id/txtAlertDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha: "
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <!-- Descripción completa -->
        <TextView
            android:id="@+id/txtAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción completa de la alerta..."
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <!-- Botón para cerrar el fragmento (opcional) -->
        <Button
            android:id="@+id/btnCloseDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerrar"/>
    </LinearLayout>
</ScrollView>
