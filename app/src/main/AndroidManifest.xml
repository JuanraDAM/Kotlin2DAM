<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para Android 13 o superior -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:name=".application.App"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Example_with_catalogs"
        tools:targetApi="31">

        <!-- Actividad de Login: se lanzará primero al iniciar la app. -->
        <activity
            android:name=".ui.views.activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad principal: se invocará desde LoginActivity una vez verificado el login. -->
        <activity
            android:name=".ui.views.activities.MainActivity"
            android:exported="true" />

        <!-- Aquí puedes declarar el resto de actividades si las hubiera -->

    </application>

</manifest>
